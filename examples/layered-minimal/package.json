{
  "name": "layered-minimal",
  "version": "1.0.0",
  "description": "Minimal layered reel — CompositionTheme + LayeredReel + LayeredReelComposition, no API keys",
  "scripts": {
    "studio": "npx remotion studio",
    "render": "npx remotion render src/index.ts MinimalReel out/reel.mp4",
    "still": "npx remotion still src/index.ts MinimalReel out/frame.png --frame=45",
    "upgrade": "npx remotion upgrade",
    "pixel-gate": "node scripts/render-transition-matrix.mjs",
    "pixel-gate:self-test": "node scripts/render-transition-matrix.mjs --self-test",
    "pixel-gate:update": "node scripts/render-transition-matrix.mjs --update-goldens",
    "typecheck": "tsc --noEmit && node scripts/verify-typecheck-coverage.mjs",
    "verify-coverage": "node scripts/verify-typecheck-coverage.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.425",
    "@remotion/transitions": "4.0.425",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.425",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
