{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@video-toolkit/lib/*": ["../../lib/*"]
    }
  },
  "include": ["src/**/*", "remotion.config.ts"],
  "exclude": ["node_modules", "out"]
}
