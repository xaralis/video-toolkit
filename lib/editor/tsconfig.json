{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@video-toolkit/lib/*": ["../*"],
      // Out-of-tree lib/render and lib/theming files import the bare specifier
      // "remotion"; tsc resolves bare specifiers by walking up node_modules from the
      // importing file, which never reaches this package's node_modules for files
      // that live outside it. Do not delete this as redundant with the ambient
      // resolution — it is the only thing that makes those 6 occurrences resolve.
      "remotion": ["./node_modules/remotion"],
      // Same problem, same fix, for the out-of-tree files that a test here now
      // imports (lib/render/at-cut-transitions.tsx and the lib/transitions
      // presentations it pulls in). These mirror examples/layered-minimal's
      // tsconfig exactly — read docs/superpowers/core-typecheck-gate.md before
      // touching them; the two non-obvious parts are that the subpath
      // declarations live under dist/presentations (not dist/esm), and that
      // "react" must map to @types/react, since the JS package ships no
      // declarations and mapping there silently `any`s the whole surface.
      "@remotion/transitions": ["./node_modules/@remotion/transitions"],
      "@remotion/transitions/*": ["./node_modules/@remotion/transitions/dist/presentations/*"],
      // Same problem, same fix, for lib/render/layered-composition-props.ts's
      // `getVideoMetadata` import — a plain `main`/`types` package (no subpath
      // exports map), so unlike `@remotion/transitions` above one entry covers it.
      "@remotion/media-utils": ["./node_modules/@remotion/media-utils"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"]
    }
  },
  "include": [
    "src",
    "app",
    "host",
    "../theming",
    // Declared, not derived: these out-of-tree lib/render files only enter this
    // program today because a test happens to import them (at-cut-transitions.test.tsx,
    // load-fonts.test.ts). Deleting either test would silently shrink this gate's
    // coverage with no error and no exit-code signal — the same failure mode
    // examples/layered-minimal/scripts/verify-typecheck-coverage.mjs guards against for
    // the OTHER type-check gate. Listing them here explicitly removes that dependency.
    // lib/transitions and the remaining pure lib/render/*.ts files still arrive only by
    // transitive import (from at-cut-transitions.tsx / layered-composition-props.ts
    // etc.), which is fine — they have no test-only, deletable path into the program.
    "../render/at-cut-transitions.tsx",
    "../render/audio-track.tsx",
    "../render/layered-composition.tsx",
    "../render/video-track.tsx",
    "../render/load-fonts.ts"
  ]
}
